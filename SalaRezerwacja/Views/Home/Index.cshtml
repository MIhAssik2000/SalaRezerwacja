@{
    ViewData["Title"] = "Start";
}

<div class="panel mb-4">
    <h1 class="h3 mb-2">System rezerwacji sal</h1>
    <p class="text-muted mb-4">Sprawdź dostępność, zarezerwuj salę i zarządzaj swoimi rezerwacjami.</p>

    <div class="row g-4">
        <div class="col-6 col-md-4">
            <div class="stat-number">@ViewBag.RoomCount</div>
            <div class="text-muted">sal w bazie</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="stat-number">@ViewBag.FreeRoomCount</div>
            <div class="text-muted">sal oznaczonych jako wolne</div>
        </div>
        <div class="col-6 col-md-4">
            <div class="stat-number">@ViewBag.TodayReservations</div>
            <div class="text-muted">rezerwacji na dziś</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="panel h-100">
            <h2 class="h6">Znajdź wolną salę</h2>
            <p class="text-muted small">Filtruj po dacie, budynku, pojemności i wyposażeniu.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Rooms" asp-action="Index">Przejdź do wyszukiwania</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel h-100">
            <h2 class="h6">Zobacz kalendarz</h2>
            <p class="text-muted small">Zajętość wszystkich sal w widoku tygodnia i miesiąca.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Calendar" asp-action="Index">Otwórz kalendarz</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel h-100">
            <h2 class="h6">Zaloguj się kontem uczelnianym</h2>
            <p class="text-muted small">Logowanie danymi z domeny uczelni, bez zakładania nowego hasła.</p>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="UniversityAuth" asp-action="Login">Konto uczelniane</a>
        </div>
    </div>
</div>

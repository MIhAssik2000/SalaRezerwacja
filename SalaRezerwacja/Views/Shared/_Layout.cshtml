@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Rezerwacja sal</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="app-header">
    <div class="container d-flex flex-wrap align-items-center gap-3">
        <a class="brand" asp-controller="Home" asp-action="Index">Rezerwacja sal</a>
        <nav class="nav flex-grow-1">
            <a class="nav-link" asp-controller="Rooms" asp-action="Index">Sale</a>
            <a class="nav-link" asp-controller="Calendar" asp-action="Index">Kalendarz</a>
            @if (SignInManager.IsSignedIn(User))
            {
                <a class="nav-link" asp-controller="Reservations" asp-action="Create">Zarezerwuj</a>
                <a class="nav-link" asp-controller="Reservations" asp-action="Index">Moje rezerwacje</a>
            }
            @if (User.IsInRole(Roles.Administracja) || User.IsInRole(Roles.Opiekun))
            {
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Raporty</a>
            }
        </nav>
        <div class="d-flex align-items-center gap-2">
            @if (SignInManager.IsSignedIn(User))
            {
                <span class="user-chip">@UserManager.GetUserName(User)</span>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-light">Wyloguj</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-outline-light" asp-area="Identity" asp-page="/Account/Login">Zaloguj</a>
                <a class="btn btn-sm btn-light" asp-area="Identity" asp-page="/Account/Register">Zarejestruj się</a>
            }
        </div>
    </div>
</header>

<main class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</main>

<footer class="app-footer">
    <div class="container">System rezerwacji sal na uczelni — projekt zaliczeniowy</div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

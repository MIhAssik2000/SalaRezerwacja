@{
    ViewData["Title"] = "Logowanie kontem uczelnianym";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="panel">
            <h1 class="h5 mb-1">Logowanie kontem uczelnianym</h1>
            <p class="text-muted small mb-4">Dostawca tożsamości: @ViewBag.ProviderName</p>

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Adres w domenie uczelni</label>
                    <input name="login" class="form-control" placeholder="jan.kowalski@uczelnia.edu.pl" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Hasło</label>
                    <input name="password" type="password" class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary">Zaloguj</button>
                <a class="btn btn-link" asp-area="Identity" asp-page="/Account/Login">Zwykłe logowanie</a>
            </form>

            <hr />
            <p class="small text-muted mb-0">
                W środowisku deweloperskim działa symulacja: dowolny adres w domenie uczelni
                i hasło o długości co najmniej 6 znaków. Podłączenie prawdziwego dostawcy
                (Microsoft Entra ID / CAS / LDAP) wymaga danych rejestracyjnych z działu IT uczelni.
            </p>
        </div>
    </div>
</div>

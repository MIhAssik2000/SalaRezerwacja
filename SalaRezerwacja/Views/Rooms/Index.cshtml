@model RoomSearchViewModel
@{
    ViewData["Title"] = "Sale";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Sale</h1>
    @if (User.IsInRole(Roles.Opiekun) || User.IsInRole(Roles.Administracja))
    {
        <a class="btn btn-primary btn-sm" asp-action="Create">Dodaj salę</a>
    }
</div>

<div class="panel mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-3">
            <label class="form-label">Szukaj</label>
            <input asp-for="Query" class="form-control" placeholder="nazwa lub numer" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Budynek</label>
            <select asp-for="BuildingId" class="form-select">
                <option value="">— dowolny —</option>
                @foreach (var b in Model.Buildings)
                {
                    <option value="@b.Id" selected="@(Model.BuildingId == b.Id)">@b.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Piętro</label>
            <input asp-for="Floor" type="number" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Min. pojemność</label>
            <input asp-for="MinCapacity" type="number" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Typ sali</label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<RoomType>()" class="form-select">
                <option value="">— dowolny —</option>
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Data</label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Od</label>
            <input asp-for="FromTime" type="time" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Do</label>
            <input asp-for="ToTime" type="time" class="form-control" />
        </div>
        <div class="col-md-5">
            <label class="form-label">Wyposażenie</label>
            <div>
                @foreach (var e in Model.AllEquipment)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="EquipmentIds" value="@e.Id"
                               id="eq-@e.Id" checked="@(Model.EquipmentIds != null && Model.EquipmentIds.Contains(e.Id))" />
                        <label class="form-check-label small" for="eq-@e.Id">@e.Name</label>
                    </div>
                }
            </div>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Szukaj</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Wyczyść filtry</a>
            @if (Model.HasTimeRange)
            {
                <span class="small text-muted ms-2">Pokazano wyłącznie sale wolne w podanym przedziale.</span>
            }
        </div>
    </form>
</div>

@if (!Model.Results.Any())
{
    <div class="panel">
        <p class="mb-0">Żadna sala nie spełnia podanych kryteriów. Zmień filtry albo wybierz inny termin.</p>
    </div>
}
else
{
    <div class="panel p-0">
        <table class="table table-rooms mb-0">
            <thead>
            <tr>
                <th>Sala</th>
                <th>Lokalizacja</th>
                <th>Pojemność</th>
                <th>Typ</th>
                <th>Wyposażenie</th>
                <th>Limit</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var room in Model.Results)
            {
                <tr>
                    <td>
                        <a asp-action="Details" asp-route-id="@room.Id">@room.Name</a>
                        <div class="text-muted small">@room.Number</div>
                    </td>
                    <td>@room.Building?.Name, p. @room.Floor</td>
                    <td>@room.Capacity</td>
                    <td>@room.Type</td>
                    <td>
                        @foreach (var re in room.RoomEquipments)
                        {
                            <span class="equipment-tag">@re.Equipment?.Name</span>
                        }
                    </td>
                    <td>@room.MaxReservationMinutes min</td>
                    <td class="badge-status-@room.Status.ToString().ToLower()">@room.Status</td>
                    <td class="text-end">
                        @if (room.Status != RoomStatus.Konserwacja)
                        {
                            <a class="btn btn-sm btn-outline-primary"
                               asp-controller="Reservations" asp-action="Create"
                               asp-route-roomId="@room.Id"
                               asp-route-date="@(Model.Date?.ToString("yyyy-MM-dd"))"
                               asp-route-from="@Model.FromTime"
                               asp-route-to="@Model.ToTime">Zarezerwuj</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
